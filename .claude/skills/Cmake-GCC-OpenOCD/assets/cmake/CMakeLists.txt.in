# =============================================================================
# CMakeLists.txt.in — CMake + GCC 嵌入式工程模板
# 使用前请替换所有 @...@ 占位符，并删除不适用的部分
# =============================================================================

cmake_minimum_required(VERSION 3.28.1)   # 最低版本；Ninja 生成器需 ≥ 3.20

cmake_policy(SET CMP0123 NEW)            # ARMClang 的 -mcpu 由项目显式指定

# --- 目标平台 ---
set(CMAKE_SYSTEM_NAME Generic)           # 交叉编译固定写法
set(CPU_CORE @CPU_CORE@)                 # 例如 cortex-m3 / cortex-m4 / cortex-m0
set(CMAKE_SYSTEM_PROCESSOR ${CPU_CORE})

# --- 工具链 ---
set(CMAKE_TOOLCHAIN_FILE ${CMAKE_CURRENT_LIST_DIR}/toolchain.cmake)

# --- 项目声明：必须包含 ASM 语言 ---
project(@PROJECT_NAME@ C ASM)

# --- 构建类型：Debug 默认 -O0 -g；Release -Os ---
string(TOUPPER "${CMAKE_BUILD_TYPE}" BUILD_TYPE_UPPER)
if(BUILD_TYPE_UPPER STREQUAL "RELEASE")
    add_compile_options(-Os)
else()
    add_compile_options(-O0 -g)
endif()

# --- 芯片宏定义与头文件路径：改用 target_* 并移到 add_executable 之后（见文件尾部）---
# --- 源文件收集（CONFIGURE_DEPENDS：新增 .c 后 Ninja 自动感知）---
file(GLOB SOURCE_FILE CONFIGURE_DEPENDS
    ${CMAKE_CURRENT_LIST_DIR}/@PERIPH_SRC_DIR@/*.c
    ${CMAKE_CURRENT_LIST_DIR}/@CORE_DIR@/*.c
    ${CMAKE_CURRENT_LIST_DIR}/@DEVICE_DIR@/*.c
    ${CMAKE_CURRENT_LIST_DIR}/@USER_DIR@/*.c
)

# --- 输出路径与产物文件名 ---
set(EXECUTABLE_OUTPUT_PATH ${CMAKE_BINARY_DIR}/output)
set(HEX_FILE ${EXECUTABLE_OUTPUT_PATH}/${PROJECT_NAME}.hex)
set(BIN_FILE ${EXECUTABLE_OUTPUT_PATH}/${PROJECT_NAME}.bin)
set(MAP_FILE ${EXECUTABLE_OUTPUT_PATH}/${PROJECT_NAME}.map)

# --- 启动文件与链接脚本（按芯片密度/型号选择）---
if(USE_ARMGCC)
    set(STARTUP_FILE ${CMAKE_CURRENT_LIST_DIR}/@STARTUP_DIR@/startup_@STARTUP_NAME@.s)
    set(LINKER_SCRIPT ${CMAKE_CURRENT_LIST_DIR}/@STARTUP_DIR@/@LINKER_SCRIPT@.ld)

    # --- 编译选项（-Wall -Wextra：所有构建类型都开警告）---
    add_compile_options(
        -mcpu=${CPU_CORE}
        -mthumb
        -ffunction-sections
        -fdata-sections
        -fno-common
        -fmessage-length=0
    )
    add_compile_options(-Wall -Wextra)

    # --- 链接选项 ---
    add_link_options(
        -Wl,-Map=${MAP_FILE}
        -Wl,--print-memory-usage
        -Wl,--gc-sections
        -T ${LINKER_SCRIPT}
    )
endif()

# --- 生成可执行目标 ---
add_executable(${PROJECT_NAME} ${SOURCE_FILE} ${STARTUP_FILE})

# 芯片宏定义（@DEVICE_MACRO@ 由询问芯片型号得到，@LIBRARY_MACRO@ 常用 USE_STDPERIPH_DRIVER）
# 目标作用域：只影响本目标，不污染其他目标（优于全局 add_compile_definitions）
target_compile_definitions(${PROJECT_NAME} PRIVATE @DEVICE_MACRO@ @LIBRARY_MACRO@)

# 头文件路径：覆盖所有用到的头文件目录（目标作用域，优于全局 include_directories）
target_include_directories(${PROJECT_NAME} PRIVATE
    ${CMAKE_CURRENT_LIST_DIR}/@CORE_DIR@            # CMSIS 内核支持（core_cm3.h 等）
    ${CMAKE_CURRENT_LIST_DIR}/@DEVICE_DIR@          # 设备支持（stm32f10x.h 等）
    ${CMAKE_CURRENT_LIST_DIR}/@USER_DIR@            # 用户代码
    ${CMAKE_CURRENT_LIST_DIR}/@PERIPH_INC_DIR@      # 外设库头文件
)

set_target_properties(${PROJECT_NAME} PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY ${EXECUTABLE_OUTPUT_PATH}
    OUTPUT_NAME ${PROJECT_NAME}.elf
)

# --- POST_BUILD：生成 hex/bin 并打印固件大小 ---
if(USE_ARMGCC)
    add_custom_command(TARGET ${PROJECT_NAME} POST_BUILD
        COMMAND ${CMAKE_OBJCOPY} -Oihex $<TARGET_FILE:${PROJECT_NAME}> ${HEX_FILE}
        COMMAND ${CMAKE_OBJCOPY} -Obinary $<TARGET_FILE:${PROJECT_NAME}> ${BIN_FILE}
        COMMAND ${CMAKE_SIZE} $<TARGET_FILE:${PROJECT_NAME}>
    )
endif()
