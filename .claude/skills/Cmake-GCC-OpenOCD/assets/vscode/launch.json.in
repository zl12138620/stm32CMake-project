{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAP Debug (pyOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "pyocd",
            "serverpath": "@PYOCD_PATH@",
            "gdbPath": "@GDB_PATH@",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/output/@PROJECT_NAME@.elf",
            "targetId": "@PYOCD_TARGET_ID@",
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "showDevDebugOutput": "none"
        },
        {
            "name": "DAP Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "serverpath": "@OPENOCD_PATH@",
            // 显式指定 scripts 目录：xPack OpenOCD 布局为 openocd/scripts（非标准 share/openocd/scripts），cortex-debug 无法自动推断
            "searchDir": ["@OPENOCD_SCRIPTS_DIR@"],
            // 用 configFiles 传 *.cfg（cortex-debug 自动为每个文件生成 -f）；切勿在 serverArgs 里传 -f，那是不稳定用法
            "configFiles": [
                "interface/@PROBE_INTERFACE_CFG@",
                "target/@TARGET_CFG@"
            ],
            "gdbPath": "@GDB_PATH@",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/output/@PROJECT_NAME@.elf",
            "runToEntryPoint": "main",
            "preLaunchTask": "build",
            "showDevDebugOutput": "none"
        }
    ]
}
